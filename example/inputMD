##############################
####  PROGRAM PARAMETERS  ####
##############################
backend = CUDA
backend_precision = mixed
CUDA_list = verlet
CUDA_sort_every = 0

##############################
####    SIM PARAMETERS    ####
##############################
sim_type = MD
steps = 1e7
dt = 0.003
ensemble = nvt
T = 20C
salt_concentration = 1.0

diff_coeff = 2.5
edge_n_forces = 1
max_density_multiplier = 3
use_edge = 1
verlet_skin = 0.5
newtonian_steps = 103

interaction_type = RNA2
seq_dep_file = rna_sequence_dependent_parameters.txt
use_average_seq = 0
mismatch_repulsion = 1

##############################
####    INPUT / OUTPUT    ####
##############################
conf_file = ssRNA_science2_last_conf.dat
topology = ssRNA_science2.top
lastconf_file = ssRNA_science2_last_conf.dat
energy_file = energy.dat
trajectory_file = trajectory.dat
max_io = 5
refresh_vel = 1
restart_step_counter = 1
print_conf_interval = 5e4
print_energy_every = 5e4
thermostat = john
time_scale = linear

